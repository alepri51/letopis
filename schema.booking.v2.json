    }
  },
  {
    "id": "Slot",
    "alias": "Окно",
    "category": "HUB",
    "ancestor": "Entity",
    "ancestors": [
      "Slot",
      "Entity"
    ],
    "links": [
      {
        "class": "Schedule",
        "cardinality": 1
      }
    ],
    "order": 900,
    "attributes": {
      "id": {
        "type": "uuid",
        "generate": 5,
        "from": [
          "Schedule",
          "start"
        ]
      },
      "start": {
        "type": "date",
        "convert": true
      },
      "end": {
        "type": "date",
        "convert": true
      }
    },
    "meta": {
      "abstract": false,
      "description": "Окно — общий таймлайн произвольной длины внутри Расписания; статуса нет — занятость мастера хранит LINK занятость"
    }
  },
  {
    "id": "Booking",
    "alias": "Запись",
    "category": "HUB",
    "ancestor": "Entity",
    "ancestors": [
      "Booking",
      "Entity"
    ],
    "links": [
      {
        "class": "Customer",
        "optional": true,
        "cardinality": 1
      }
    ],
    "order": 1000,
    "attributes": {
      "status": {
        "type": "enum",
        "values": [
          "created",
          "confirmed",
          "completed",
          "cancelled",
          "no_show"
        ],
        "default": "created"
      },
      "source": {
        "type": "enum",
        "values": [
          "online",
          "web",
          "admin",
          "telegram"
        ],
        "default": "online"
      },
      "comment": "string|optional",
      "total": {
        "type": "record",
        "key": {
          "type": "enum",
          "values": [
            "RUB",
            "USD",
            "EUR",
            "AED"
          ]
        },
        "value": "number|integer|min:0",
        "default": {
          "RUB": 0
        }
      }
    },
    "meta": {
      "abstract": false,
      "description": "Запись клиента. Без мастера (мульти-мастер): мастера — на занятости/позиции. Ручная бронь по имени: без Customer, имя в comment. Дата приёма = start первого окна брони. history: полный аудит версиями"
    }
  },
