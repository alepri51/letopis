    "meta": {
      "abstract": false,
      "description": "Услуга: длительность (мин) + цена; занимает столько подряд окон, сколько покрывает duration"
    }
  },
  {
    "id": "Complex",
    "alias": "Комплекс",
    "category": "HUB",
    "ancestor": "Entity",
    "ancestors": [
      "Complex",
