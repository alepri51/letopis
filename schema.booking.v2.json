[
  {
    "id": "Entity",
    "alias": "Сущность",
    "category": "HUB",
    "ancestor": null,
    "ancestors": [
      "Entity"
    ],
    "links": [],
    "order": 100,
    "attributes": {
      "id": {
        "type": "uuid",
        "generate": 7
      }
    },
    "meta": {
      "abstract": true,
      "description": "Абстрактный корень всех сущностей"
    }
  },
  {
    "id": "Org",
    "alias": "Организация",
    "category": "HUB",
    "ancestor": "Entity",
    "ancestors": [
      "Org",
      "Entity"
    ],
    "links": [],
    "order": 200,
    "attributes": {
      "name": "string",
      "timezone": {
        "type": "string",
        "default": "Europe/Moscow"
      },
      "address": "string|optional",
      "phone": "string|optional",
      "active": {
        "type": "boolean",
        "default": true
      },
      "settings": {
        "type": "object",
        "optional": true,
        "strict": true,
        "props": {
          "booking": {
            "type": "object",
            "optional": true,
            "strict": true,
            "props": {
              "deposit": {
                "type": "object",
                "optional": true,
                "strict": true,
                "props": {
                  "amount": "number|integer|min:0|default:0",
                  "currency": {
                    "type": "enum",
                    "values": [
                      "RUB",
                      "USD",
                      "EUR",
                      "AED"
                    ],
                    "default": "RUB"
                  }
                }
              },
              "autoconfirm": "boolean|default:false"
            }
          }
        }
      }
    },
    "meta": {
      "abstract": false,
      "description": "Организация / точка / филиал — владелец каталога и расписаний; settings — вложенные настройки (пример структуры глубины 4)"
    }
  },
  {
    "id": "Staff",
    "alias": "Сотрудник",
    "category": "HUB",
    "ancestor": "Entity",
    "ancestors": [
      "Staff",
      "Entity"
    ],
    "links": [
      {
        "class": "Org",
        "cardinality": 1
      }
    ],
    "order": 300,
    "attributes": {
      "name": "string",
      "roles": {
        "type": "array",
        "items": {
          "type": "enum",
          "values": [
            "owner",
            "administrator",
            "manager",
            "master"
          ]
        },
        "default": [
          "master"
        ]
      },
      "active": {
        "type": "boolean",
        "default": true
      }
    },
    "meta": {
      "abstract": false,
      "description": "Человек: роли совмещаются (owner+master). Бронируемый ⇔ master ∈ roles. Владелец = первый сотрудник с owner."
    }
  },
  {
    "id": "Folder",
