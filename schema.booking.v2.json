      "kind": {
        "type": "enum",
        "values": [
          "services",
          "masters"
        ],
        "default": "services"
      }
    },
    "meta": {
      "abstract": false,
      "description": "Папка-категория; вложенность — ссылкой на родительскую Папку в links"
    }
  },
  {
    "id": "Service",
    "alias": "Услуга",
