        <outputs><param name="image" type="letopis-db exposing 5432/6379" /></outputs>
        <errors><error code="build/run errors surfaced by M-UP" /></errors>
      </contract>
      <interface><image-letopis-db PURPOSE="dev container" /><script-start PURPOSE="redis + postgres entrypoint" /></interface>
      <depends>none</depends>
      <target><source>lib/docker/Dockerfile</source><extra>lib/docker/start.sh</extra><tests>exercised by up() in integration runs (not analyzed)</tests></target>
      <observability><log-prefix>docker logs</log-prefix></observability>
      <verification-ref>V-M-DOCKER</verification-ref>
    </M-DOCKER>

  </Modules>

  <DataFlow>
    <DF-001 NAME="Connect" TRIGGER="connect(opts) / up(opts)">
      <step-1>Open postgres pool; if enforceAcl, look up the account</step-1>
      <step-2>loadRegistry(sql, pgSchema, partition) → Registry</step-2>
      <step-3>compileEnforcer (if enforceAcl) → aclDecide on Ctx</step-3>
      <step-4>makeDb(ctx) → EntityDb</step-4>
      <evidence>[letopis.up] connected (schema "&lt;full&gt;") — only when via up()</evidence>
    </DF-001>
    <DF-002 NAME="ReadTraversal" TRIGGER="db.Class(filter).link(...).run()/rows()/first()/ids()/count()">
      <step-1>makeChain builds Step[] (class/link/pivot, filters, tags/account/owner)</step-1>
      <step-2>buildRead(ctx, steps, mods, mode) → parameterized CTE query</step-2>
      <step-3>runQuery executes; onQuery(QueryEvent); slow-query warn if over slowMs</step-3>
      <step-4>rows normalized to Row/Path</step-4>
      <evidence>onQuery QueryEvent { mode, classes, ms, rows, slow }; console.warn slow query</evidence>
    </DF-002>
    <DF-003 NAME="Write" TRIGGER="db.Class(...).create(data)/.update(data).run()">
      <step-1>splitPlan → write segments + read tail</step-1>
      <step-2>createOp/updateOp: validate(class), resolve slots/ends, compute v5/v7 id</step-2>
      <step-3>inTransaction: insertOne (new version) with transient retry</step-3>
      <step-4>read tail returns the resulting Row(s)</step-4>
      <evidence>ValidationError on invalid data; entity_check trigger enforces at DB level</evidence>
    </DF-003>
    <DF-004 NAME="DeleteCascade" TRIGGER="db.Class(filter).delete({confirm:true}).run()">
      <step-1>delOp: ACL DELETE check per class in cascade</step-1>
      <step-2>deleteSql → entity_delete trigger tombstones + recursively deletes dependents (advisory-locked)</step-2>
      <evidence>acl denies DELETE Error when unauthorized; pg_notify on tombstone insert</evidence>
    </DF-004>
    <DF-005 NAME="AuthVerify" TRIGGER="db.auth.verifyPassword/verifyApiKey/verifyOtp/verifyTotp(...)">
      <step-1>tables.credentials.find by identity</step-1>
      <step-2>constant-time hash/secret compare (dummy-verify on miss)</step-2>
      <step-3>return AuthResult { account, credential } or null</step-3>
      <evidence>null on failure; no secret logged</evidence>
    </DF-005>
    <DF-006 NAME="AclEnforce" TRIGGER="connect({ enforceAcl:true }).as(account) then any read/write">
      <step-1>compileEnforcer builds (ClassDef,op)→AclDecision for the account+categories</step-1>
      <step-2>buildRead injects row filter / denies READ; aclWrite denies WRITE/DELETE</step-2>
      <evidence>acl denies &lt;op&gt; on &lt;class&gt; Error; deny-by-default</evidence>
    </DF-006>
    <DF-007 NAME="Session" TRIGGER="db.auth.sessions(store).start/check/revoke">
      <step-1>start: sha256(token) stored under sess:&lt;h&gt; with TTL; account set sess:acc:&lt;id&gt;</step-1>
      <step-2>check: read+parse session; revoke/revokeAll: del keys</step-2>
      <evidence>Session|null; token never stored in plaintext</evidence>
    </DF-007>
    <DF-008 NAME="Bootstrap" TRIGGER="up(opts)">
      <step-1>ensureContainer: docker build/run timescaledb+redis (or skip for remote dsn)</step-1>
      <step-2>ensureDatabase: create db if missing (ignore race 42P04)</step-2>
      <step-3>applySchema: apply ddl.sql + seeds into "v&lt;version&gt;.&lt;schema&gt;" (fresh drops first)</step-3>
      <step-4>wait for pg + redis ready, then connect()</step-4>
      <evidence>[letopis.up] container/image/schema/ready/connected messages</evidence>
    </DF-008>
    <DF-009 NAME="Watch" TRIGGER="db.watch(cb) / db.watch(class, cb)">
      <step-1>LISTEN on channel = schema name</step-1>
      <step-2>entity_notify AFTER INSERT → pg_notify payload → WatchEvent to cb</step-2>
      <step-3>reconnect invokes onReconnect</step-3>
      <evidence>WatchEvent { partition, class, id, updated, deleted }</evidence>
    </DF-009>
    <DF-010 NAME="Batch" TRIGGER="const b = db.batch(name); b.Class()…; await b.run()">
      <step-1>queue BatchPlans without executing</step-1>
      <step-2>executeBatch: pure-insert plans fast-pathed into one multi-insert; else per-plan</step-2>
      <evidence>Row[][] results, one per queued plan</evidence>
    </DF-010>
  </DataFlow>

