    {
      "title": "Подтверждение кодом: контакт сменился везде",
      "text": "`me.changeContact({ email: новый, code })` — контакт аккаунта и имя для входа у паролей во всех квартирах сменились; ответ — новый контакт. Пароль прежний, а входить им теперь с новым адресом: старый больше не подходит. Неверный код — `auth_failed` (`api.code_failed`).",
      "code": "const wrong = await why(me.changeContact({ email: 'anna@example.com', code: '000000' }));\nconst changed = await me.changeContact({ email: 'anna@example.com', code: lastLetter('anna@example.com', 'contact').code });\nreturn {\n  'неверный код': wrong,\n  'контакт': changed.contact,\n  'вход с новым адресом': (await db.open({ email: 'anna@example.com', password: annaKey.password })).tenantName,\n  'вход со старым адресом': await why(db.open(annaKey)),\n};",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> wrong</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> why</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(me.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">changeContact</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'anna@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, code: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'000000'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> changed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> me.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">changeContact</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'anna@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, code: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lastLetter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'anna@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'contact'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).code });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'неверный код'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: wrong,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'контакт'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: changed.contact,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'вход с новым адресом'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">open</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ email: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'anna@example.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, password: annaKey.password })).tenantName,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  'вход со старым адресом'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> why</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">open</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(annaKey)),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span></code></pre>",
