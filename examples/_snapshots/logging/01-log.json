    {
      "title": "Логгер — console",
      "text": "`log: console` — события идут в `console.info`, `console.warn`, `console.error` по уровню: первым аргументом объект события, вторым — его имя. Здесь два события уровня info: `connect` (подключение готово) и `write` (записана заметка). Чтобы показать их и в ответе шага, `console.info` на время шага ещё и запоминает, что получил; в своей программе это не нужно — события просто печатаются. Таблицы меняет только запись заметки.",
      "code": "await syncModels(db, [Note], { apply: true });\nconst printed: { вызов: string; event: string; op?: string }[] = [];\nconst info = console.info;\nconsole.info = (e: LogEvent, name: string) => {\n  printed.push({ вызов: 'console.info', event: name, op: e.op });\n  info(e, name); // console печатает событие как обычно\n};\ntry {\n  const app = await connect({ dsn: dsn.app, schema, token: up.tenant!.token!, log: console, logLevel: 'info' });\n  await app.Note().create({ text: 'первая заметка' }).rows();\n} finally {\n  console.info = info;\n}\nreturn printed;",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> syncModels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(db, [Note], { apply: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> printed</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">вызов</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">event</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">op</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }[] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> info</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> console.info;</span></span>\n<span class=\"line