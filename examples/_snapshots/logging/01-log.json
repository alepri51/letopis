  "source": "import { syncModels } from 'letopis';\nimport { hub } from 'letopis/model';\nimport { z } from 'zod';\nimport { example } from '../_shared/example.ts';\n\n// Модель: заметка с текстом.\nconst Note = hub('Note', { text: z.string() });\n\nexport default example({\n  title: 'Логирование: что делает letopis',\n  summary:\n    'connect({ log, logLevel }) пишет события: запись, удаление, восстановление, ошибки, вход. log — console, pino или ' +\n    'своя функция; logLevel — порог (по умолчанию info). Пароли, токены и ключи в событиях всегда замаскированы.',\n  covers: ['connect.log', 'connect.logLevel'],\n  steps: [\n    {\n      title: 'Логгер — console',\n      text:\n        '`log: console` — события идут в `console.info`, `console.warn`, `console.error` по уровню: первым аргументом ' +\n        'объект события, вторым — его имя. Запустите пример сам (`npx tsx logging/01-log.ts`) — события `connect` и ' +\n        '`write` появятся в выводе. Таблицы меняет только запись заметки.',\n      run: async ({ db, connect, dsn, schema, up }) => {\n        await syncModels(db, [Note], { apply: true });\n        const app = await connect({ dsn: dsn.app, schema, token: up.tenant!.token!, log: console, logLevel: 'info' });\n        const [note] = await app.Note().create({ text: 'первая заметка' }).rows();\n        return note.data;\n      },\n    },\n    {\n      title: 'Свой логгер: события write, delete, restore, error',\n      text:\n        'Функция в `log` получает каждое событие уровня `info` и выше. Превью удаления (`delete.preview`) и чтение ' +\n        '(`read`) — уровень `debug`, ниже порога: их не видно. Повторный `restore` уже возвращённой заметки — отказ ' +\n        '`not_deleted`, и событие `error` несёт его код и ключ. В ответе — главное из каждого события; кроме этого в ' +\n        'нём время `ts`, длительность `ms`, арендатор, аккаунт и цепочка `chain`.',\n      run: async ({ connect, dsn, schema, up }) => {\n        const events: Record<string, unknown>[] = [];\n        const app = await connect({ dsn: dsn.app, schema, token: up.tenant!.token!, log: (e) => void events.push({ ...e }), logLevel: 'info' });\n        const [note] = await app.Note().create({ text: 'черновик' }).rows();\n        const preview = await app.Note(note).delete().rows();\n        const gone = await app.Note(note).delete({ confirm: true, expect: preview }).rows();\n        await app.Note(note).restore({ expect: gone }).rows();\n        await app.Note(note).restore({ expect: gone }).rows().catch(() => null); // уже вернули — отказ\n        return events.map(({ level, event, op, rows, code, key }) => ({ level, event, op, rows, code, key }));\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncModels } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hub } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../_shared/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Модель: заметка с текстом.</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Note</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Note'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { text: z.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Логирование: что делает letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  summary:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'connect({ log, logLevel }) пишет события: запись, удаление, восстановление, ошибки, вход. log — console, pino или '</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'своя функция; logLevel — порог (по умолчанию info). Пароли, токены и ключи в событиях всегда замаскированы.'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  covers: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'connect.log'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'connect.logLevel'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  steps: [</sp