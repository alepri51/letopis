    {
      "title": "С forUpdate(): то же блокировкой строки",
      "text": "`forUpdate()` в транзакции блокирует прочитанную строку: второе чтение той же строки с `forUpdate()` ждёт фиксации первого. Защищает, только если так читают все, кто правит эти данные; для сумм проще `inc` — база сама сложит приращения и проверит `min(0)`.",
      "code": "await me.Card(card).update({ balance: 500 }, { reason: 'снова 500' }).rows();\nlet second!: Promise<string>, waited = false;\nconst first = await debit(me, 400, { forUpdate: true }, async () => {\n  second = debit(me, 400, { forUpdate: true });\n  waited = await waitForLock(admin);\n});\nreturn { 'первое': first, 'второе ждало строку': waited, 'второе': await second, 'на карте': (await me.Card(card).first())!.data.balance };",
