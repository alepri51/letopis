    {
      "title": "С lock(): второе ждёт, читает 100 и получает отказ",
      "text": "`tr.lock(ключ)` — блокировка до конца транзакции. Второе списание берёт тот же ключ и встаёт в очередь — это видно по базе (`waitForLock`). Первое записывает итог и фиксируется, второе читает уже 100.",
      "code": "await me.Card(card).update({ balance: 500 }, { reason: 'снова 500' }).rows();\nlet second!: Promise<string>, waited = false;\nconst first = await debit(me, 400, { lock: true }, async () => {\n  second = debit(me, 400, { lock: true });\n  waited = await waitForLock(admin);\n});\nreturn { 'первое': first, 'второе ждало блокировку': waited, 'второе': await second, 'на карте': (await me.Card(card).first())!.data.balance };",
