      "title": "Продолжить с курсора старого события",
      "text": "`ev.cursor` старого события — позиция сразу после него. Новая подписка с него получает следующее событие — влажность: курсору год, а ничего не пропало.",
      "code": "const again = db.watch({ from: old.cursor, classes: ['Gauge'] });\ntry {\n  const ev = (await again.next()).value;\n  return { op: ev.op, 'датчик': ev.row.data.name };\n} finally { again.close(); }",
