  },
  "steps": [
    {
      "title": "Новый класс и подписка на него",
      "text": "Класс записывает `adm` — администраторское подключение: `connect({ dsn: <DSN администратора базы>, …, allowBypassRls: true })`, правила доступа (RLS) на нём не действуют. Оно нужно только загрузчику в следующем шаге: писать версии задним числом может лишь такое подключение, подключение по токену пользователя получит `admin_required`. В своём приложении класс записывает и обычное подключение арендатора. Подключение Анны узнаёт о новом классе по сигналу базы, с небольшой задержкой: описания классов оно держит в памяти (реестр классов). Сразу — `db.refresh()`.",
      "code": "adm = await connect({ dsn: dsn.admin, schema, token: up.tenant!.token!, allowBypassRls: true });\nawait syncModels(adm, [Gauge], { apply: true });\nawait db.refresh();\nsub = db.watch({ from: 'now', classes: ['Gauge'], pollMs: 100 });\nawait sub.ready();\nreturn { 'класс Gauge в реестре Анны': db.registry.has('Gauge') };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">adm </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> connect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ dsn: dsn.admin, schema, token: up.tenant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.token</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, allowBypassRls: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> syncModels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(adm, [Gauge], { apply: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">refresh</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">sub </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">watch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ from: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'now'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, classes: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Gauge'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], pollMs: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> sub.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">ready</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'класс Gauge в реестре Анны'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: db.registry.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">has</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Gauge'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) };</span></span></code></pre>",
