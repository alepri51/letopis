{
  "id": "watch/02-quiet-cursor",
  "title": "Курсор подписки не устаревает",
  "summary": "Журнал хранит каждую версию, поэтому курсор подписки не устаревает: продолжить можно с любого сохранённого курсора — и через минуту, и через год. sub.cursor — позиция после последнего события, которое отдала подписка, ev.cursor — позиция после этого события.",
  "covers": [
    "nuance.watch-subscription-cursor",
    "load.withHistory",
    "db.refresh",
    "nuance.registry-refresh"
  ],
  "tables": [],
  "context": {
    "schema": "v2.g_watch_02_quiet_cursor",
    "dsn": {
