    {
      "title": "Цикл for await, отставание и выход из цикла",
      "text": "`for await (const ev of sub)` выдаёт события по одному и ждёт новых. Выход из цикла (`break`) сам закрывает подписку: следующий `next()` отвечает `done: true`. `sub.lag()` — сколько миллисекунд ждёт самое старое записанное событие, которое ещё задерживает более старая открытая транзакция; 0 — ждать нечего.",
      "code": "const sub = me.watch({ from: 'start', classes: ['Product'] });\nconst got: string[] = [];\nfor await (const ev of sub) {\n  got.push(`${ev.op} ${ev.row.data.title}`);\n  if (got.length === 3) break;\n}\nreturn { 'события': got, 'ждать нечего (lag = 0)': (await sub.lag()) === 0, 'после break: done': (await sub.next()).done };",
