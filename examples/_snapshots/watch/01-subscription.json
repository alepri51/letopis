  "steps": [
    {
      "title": "Магазин и два товара",
      "text": "Анна заводит в «Ромашке» магазин и два товара. Каждая запись — версия в журнале `log`: подписка читает именно журнал, поэтому прошлые изменения не пропадают, даже если в момент записи подписки не было.",
      "code": "[shop] = await me.Shop().create({ name: 'Ромашка' }).rows();\nawait me.Shop(shop).Product().create({ sku: 'K-1', title: 'Чайник', price: 2500 }).rows();\nawait me.Shop(shop).Product().create({ sku: 'M-1', title: 'Кружка', price: 400 }).rows();\nreturn (await me.Product().sort('data.sku').rows()).map((p) => `${p.data.sku} ${p.data.title}`);",
