  "steps": [
    {
      "title": "Сессии и коды копятся в secret",
      "text": "Анна входит паролем и выходит (`auth.revoke()`) — сессия погашена. Потом сервис присылает ей одноразовый код, и она входит по нему — код использован. Обе строки остаются в `secret`, пока их не уберёт обслуживание.",
      "code": "const login = await svc.auth.verifyPassword({ identifier: user.login, password: user.password });\nconst anna = await connect({ dsn: dsn.app, schema, token: login!.token });\nawait anna.auth.revoke();\nconst { code } = await svc.auth.issueOtp({ account: login!.account, identifier: user.login });\nconst byCode = await svc.auth.verifyOtp({ identifier: user.login, code });\nreturn { 'выход паролем': 'сессия погашена', 'вход по коду': byCode ? 'код использован' : 'не вошла' };",
