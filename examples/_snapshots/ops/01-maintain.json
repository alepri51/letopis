  "source": "import type { Db } from 'letopis';\nimport { example } from '../_shared/example.ts';\n\nlet adm: Db;\n\nexport default example({\n  title: 'Обслуживание: maintain() убирает погашенные сессии и коды',\n  summary:\n    'Сессии и одноразовые коды живут в таблице secret. Истёкшие и погашенные строки убирает maintain(): его вызывает ' +\n    'планировщик (letopis maintain) или сама библиотека — connect({ maintain: \\'1h\\' }). Журнал maintain() не трогает.',\n  tables: ['counts'],\n  covers: ['db.maintain'],\n  steps: [\n    {\n      title: 'Сессии и коды копятся в secret',\n      text:\n        'Анна входит паролем и выходит (`auth.revoke()`) — сессия погашена. Потом сервис присылает ей одноразовый код, ' +\n        'и она входит по нему — код использован. Обе строки остаются в `secret`, пока их не уберёт обслуживание.',\n      run: async ({ svc, connect, dsn, schema, user }) => {\n        const login = await svc.auth.verifyPassword({ identifier: user.login, password: user.password });\n        const anna = await connect({ dsn: dsn.app, schema, token: login!.token });\n        await anna.auth.revoke();\n        const { code } = await svc.auth.issueOtp({ account: login!.account, identifier: user.login });\n        const byCode = await svc.auth.verifyOtp({ identifier: user.login, code });\n        return { 'выход паролем': 'сессия погашена', 'вход по коду': byCode ? 'код использован' : 'не вошла' };\n      },\n    },\n    {\n      title: 'maintain() убирает лишнее',\n      text:\n        'Отчёт: `sessions` — удалено сессий (истёкших и погашенных), `codes` — кодов (истёкших, использованных, заменённых ' +\n        'новым, исчерпавших попытки), `queue` — заполнение очереди сигналов PostgreSQL (больше половины — предупреждение), ' +\n        '`skipped` — обслуживание уже идёт в другом процессе. Ещё `maintain()` удаляет строки-замки удалённых классов. ' +\n        'Вызывает его системный администратор, роль с правом `letopis.maintain` или администраторское подключение.',\n      run: async ({ connect, dsn, schema, up }) => {\n        adm = await connect({ dsn: dsn.admin, schema, token: up.tenant!.token!, allowBypassRls: true });\n        return adm.maintain();\n      },\n    },\n    {\n      title: 'Повторный вызов — убирать нечего',\n      text: 'Обслуживание — одна транзакция под блокировкой обслуживания: из нескольких процессов работает один, остальные получают `skipped: true`.',\n      run: async () => adm.maintain(),\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Db } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../_shared/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> adm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Db</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Обслуживание: maintain() убирает погашенные сессии и коды'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  summary