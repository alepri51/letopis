  "steps": [
    {
      "title": "sync: сухой прогон, проверка и запись моделей",
      "text": "`letopis sync модуль --token …` берёт из файла-модуля всё, у чего есть `describe()`, и сравнивает с базой. Здесь модуль — `shop-model.mjs` с моделью магазина: программа записывает его во временную папку проекта (оттуда видны пакеты `letopis` и `zod`). Без `--apply` это сухой прогон — ничего не записывается; с `--apply` модели записываются. `--check` — тот же сухой прогон, но с кодом 1, если есть что создать или изменить: шаг CI перед `--apply`.",
      "code": "dir = await mkdtemp(join(process.cwd(), 'letopis-cli-'));\nmodel = join(dir, 'shop-model.mjs');\nawait writeFile(model, SHOP_MODEL);\ntoken = up.tenant!.token!;\nbase = ['--dsn', dsn.app, '--schema', schema, '--token', token];\nconst dry = await letopis(['sync', model, ...base]);\nconst before = await letopis(['sync', model, ...base, '--check']);\nconst real = await letopis(['sync', model, ...base, '--apply']);\nconst after = await letopis(['sync', model, ...base, '--check']);\nreturn {\n  'сухой прогон': dry.out.split('\\n')[0], '--check до --apply, код': before.code,\n  'с --apply': real.out.split('\\n')[0], '--check после --apply, код': after.code,\n};",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dir </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> mkdtemp</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(process.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cwd</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'letopis-cli-'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">model </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> join</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(dir, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'shop-model.mjs'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> writeFile</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(model, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">SHOP_MODEL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">token </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> up.tenant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.token</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">base </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'--dsn'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, dsn.app, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'--schema'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, schema, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'--token'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, token];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> dry</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> letopis</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sync'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, model, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">base]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> before</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> letopis</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sync'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, model, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\"