    {
      "title": "Настройки класса — в реестре подключения",
      "text": "`db.registry` — описания классов, которые подключение прочло из базы: `find(имя)` отдаёт поля (`schema`), ключ, концы, `history`, `ownerDefault` и `meta`. Так интерфейс строит меню по `meta.title` и `meta.order`. ИИ-агенту модель отдаёт инструмент MCP `letopis_model` (глава «ИИ-агенты: MCP»).",
      "code": "const pick = (name: string) => {\n  const c = db.registry.find(name)!;\n  return { history: c.history, ownerDefault: c.ownerDefault, meta: c.meta };\n};\nreturn { Ping: pick('Ping'), Draft: pick('Draft'), Product: pick('Product') };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> pick</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">name</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> db.registry.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">find</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(name)</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { history: c.history, ownerDefault: c.ownerDefault, meta: c.meta };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Ping: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Ping'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), Draft: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Draft'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), Product: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">pick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Product'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) };</span></span></code></pre>",
