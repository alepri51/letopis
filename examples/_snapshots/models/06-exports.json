      "text": null,
      "code": "const h = await hashPassword('Секрет-2026');\nreturn { 'хэш начинается с': h.slice(0, 7), 'верный': await verifyHash('Секрет-2026', h), 'неверный': await verifyHash('не тот', h) };",
