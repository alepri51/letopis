  "source": "import { syncModels } from 'letopis';\nimport { hub } from 'letopis/model';\nimport { z } from 'zod';\nimport { example } from '../_shared/example.ts';\n\nconst Person = hub('Person', { fields: { name: z.string() }, abstract: true });\nconst Customer = hub('Customer', { extends: Person, fields: { email: z.string() }, alias: 'Клиент' });\nconst Vip = hub('Vip', { extends: Customer, fields: { discount: z.number().int().min(0).max(50) } });\n\nexport default example({\n  title: 'Наследование, абстрактный класс и алиас',\n  summary:\n    'Потомок получает поля, концы и ключ предка. Шаг по классу находит и строки потомков, .exact() — только сам ' +\n    'класс. Абстрактный класс своих строк не имеет. Алиас — второе имя класса, например по-русски.',\n  covers: ['class.extends', 'class.abstract', 'class.alias', 'chain.exact', 'nuance.polymorphic-read'],\n  steps: [\n    {\n      title: 'Описываем: человек → клиент → VIP',\n      run: async ({ db }) => {\n        const r = await syncModels(db, [Person, Customer, Vip], { apply: true });\n        return r.created;\n      },\n    },\n    {\n      title: 'Клиент и VIP-клиент',\n      text: 'У VIP есть все поля клиента (`name`, `email`) и своё поле `discount`.',\n      run: async ({ db }) => {\n        await db.Customer().create({ name: 'Ольга', email: 'olga@mail.ru' }).rows();\n        return db.Vip().create({ name: 'Иван', email: 'ivan@mail.ru', discount: 10 }).rows();\n      },\n    },\n    {\n      title: 'Шаг по классу находит и потомков',\n      text: '`db.Customer()` отдаёт и Ольгу (Customer), и Ивана (Vip): VIP — тоже клиент.',\n      run: async ({ db }) => (await db.Customer().sort('data.name').rows()).map((r) => ({ name: r.data.name, class: r.class })),\n    },\n    {\n      title: '.exact() — только сам класс',\n      run: async ({ db }) => (await db.Customer().exact().rows()).map((r) => ({ name: r.data.name, class: r.class })),\n    },\n    {\n      title: 'Алиас — второе имя для шага',\n      text: 'У класса `Customer` алиас `Клиент`: шаг `db.Клиент()` — то же самое.',\n      run: async ({ db }) => db.Клиент().count(),\n    },\n    {\n      title: 'У абстрактного класса нет своих строк',\n      text: '`Person` — абстрактный: создать «просто человека» нельзя, только клиента или VIP.',\n      run: async ({ db }) => db.Person().create({ name: 'Никто' }).rows(),\n      expect: { error: 'invalid_class' },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncModels } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hub } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../_shared/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Person</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62