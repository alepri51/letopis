    {
      "title": "maxRows: не больше двух строк за ответ",
      "text": "Строк больше — в ответе `more: true` и `cursor`: следующий вызов с ним продолжит.",
      "code": "await seedShop(me);\nconst page = (await tool(me, { maxRows: 2 }, 'letopis_query', { class: 'Product' })) as { rows: unknown[]; more?: boolean; cursor?: unknown };\nreturn { 'строк': page.rows.length, more: page.more ?? false, 'курсор есть': page.cursor !== undefined };",
