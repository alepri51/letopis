    {
      "title": "maxBytes: ответ не больше 1000 байт",
      "text": "Предел в байтах JSON: что не поместилось — на следующих страницах, хотя бы одна строка в ответе есть всегда.",
      "code": "const page = (await tool(me, { maxBytes: 1000 }, 'letopis_query', { class: 'Product' })) as { rows: unknown[]; more?: boolean };\nreturn { 'строк': page.rows.length, more: page.more ?? false };",
