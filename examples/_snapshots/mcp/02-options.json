    {
      "title": "Запись в классы прав — только с allowAclWrite",
      "text": "Без опции агент не может завести ресурс или правило, сменить роли прописки — `acl_denied`, даже если жильцу это можно: агент, которому в данных подсунули чужие инструкции, не выдаст себе права без человека.",
      "code": "({\n        'без опции': await tool(me, { write: true }, 'letopis_write', { op: 'create', class: 'Resource', data: { alias: 'x:API', category: 'API', pattern: { endpoint: 'x.*' } } }),\n        'с allowAclWrite': await tool(me, { write: true, allowAclWrite: true }, 'letopis_write', { op: 'create', class: 'Resource', data: { alias: 'y:API', category: 'API', pattern: { endpoint: 'y.*' } } })\n          .then((r) => ((r as { rows?: unknown[] })?.rows ? 'ресурс создан' : r)),\n      })",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'без опции'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> tool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(me, { write: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'letopis_write'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { op: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'create'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, class: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Resource'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, data: { alias: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'x:API'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, category: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'API'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, pattern: { endpoint: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'x.*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } } }),</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        'с allowAclWrite'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> tool</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(me, { write: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, allowAclWrite: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'letopis_write'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { op: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'create'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, class: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Resource'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, data: { alias: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'y:API'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, category: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'API'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, pattern: { endpoint: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'y.*'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } } })</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">r</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ((r </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">rows</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[] })?.rows </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'ресурс создан