    {
      "title": "isolation_level — удаление в транзакции REPEATABLE READ",
      "text": "Удаление с каскадом требует READ COMMITTED (так работает библиотека). Здесь SQL мастер-ключом открывает транзакцию REPEATABLE READ с токеном сессии Анны; ошибку драйвера в `LetopisError` переводит `fromDbError`. Что делать: не менять уровень изоляции для удаления.",
      "code": "try {\n  return await admin.begin('isolation level repeatable read', async (tx) => {\n    await tx`select set_config('letopis.token', ${me.token!}, true)`;\n    return tx.unsafe(`delete from ${T(schema)} where id = $1`, [d.mug]);\n  });\n} catch (e) { throw fromDbError(e); }",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> admin.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">begin</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'isolation level repeatable read'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">async</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">tx</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> tx</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`select set_config('letopis.token', ${</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">me</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">.</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">token</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">}, true)`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tx.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unsafe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`delete from ${</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">T</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">(</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">schema</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">)</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">} where id = $1`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, [d.mug]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">} </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">catch</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (e) { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throw</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> fromDbError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e); }</span></span></code></pre>",
