  "steps": [
    {
      "title": "Установка с готовой моделью салона и своими настройками",
      "text": "`seeds: ['booking']` добавляет готовые классы салона (мастера, услуги, брони) — в сводке классов стало больше. `signals` — режим сигналов, `serviceKey` — свой ключ вместо случайного, `waitTimeoutMs` — сколько ждать базу. Неизвестную опцию `up()` отклоняет до подключения — `invalid_data` с похожими именами.",
      "code": "const r = await up({\n  dsn: dsn.admin, schema, quiet: true, waitTimeoutMs: 10_000,\n  seeds: ['booking'],\n  signals: 'tenant',\n  serviceKey: MY_KEY,\n});\nreturn { created: r.created, signals: r.signals, ourKey: r.serviceKey === MY_KEY };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> up</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  dsn: dsn.admin, schema, quiet: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, waitTimeoutMs: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">10_000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  seeds: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'booking'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  signals: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'tenant'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  serviceKey: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">MY_KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { created: r.created, signals: r.signals, ourKey: r.serviceKey </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MY_KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span></code></pre>",
