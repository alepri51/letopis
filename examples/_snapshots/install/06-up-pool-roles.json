  "steps": [
    {
      "title": "Установка через готовый пул, с ролями по умолчанию и первым арендатором",
      "text": "`sql` — готовый пул postgres.js вместо строки подключения. `owner` и `app` — имена ролей владельца схемы и приложения (здесь — те же, что по умолчанию). `migrationsDir` — каталог миграций для `upgrade: true` вместо каталога пакета: на свежей схеме миграций нет, поэтому каталог `migrate` рядом с программой может и не существовать.",
      "code": "const r = await up({\n  sql: admin as never, schema, fresh: true, quiet: true, owner: 'letopis_owner', app: 'letopis_app', migrationsDir: MIGRATIONS,\n  signals: 'none', tenant: { name: 'Ромашка', user: { name: 'Анна', login: 'anna@romashka.ru', password: 'Ромашка-2026!' } },\n});\nreturn { created: r.created, revision: r.revision, 'арендатор создан': r.tenant!.created, signals: (r as { signals?: string }).signals ?? 'none' };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> r</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> up</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  sql: admin </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> never</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, schema, fresh: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, quiet: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, owner: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'letopis_owner'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, app: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'letopis_app'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, migrationsDir: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">MIGRATIONS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  signals: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'none'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, tenant: { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Ромашка'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, user: { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Анна'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, login: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'anna@romashka.ru'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, password: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Ромашка-2026!'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { created: r.created, revision: r.revision, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'арендатор создан'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: r.tenant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.created, signals: (r </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">signals</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }).signals </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'none'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> };</span></span></code></pre>",
