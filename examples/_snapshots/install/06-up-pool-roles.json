an class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'кэш включён'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: db.cache.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stats</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().enabled, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'слушателей'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: db.cache.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stats</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().listens };</span></span></code></pre>",
