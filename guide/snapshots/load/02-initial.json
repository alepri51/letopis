  "source": "import { up } from 'letopis';\nimport type { Db } from 'letopis';\nimport { example } from '../../kit/example.ts';\nimport { syncShop } from '../../kit/shop.ts';\n\nlet adm: Db;\n\nexport default example({\n  title: 'Первая заливка: db.load(…, { initial: true })',\n  summary:\n    'Для переезда с другой системы: пустая схема, одна транзакция, COPY без построчных триггеров и индексов — ' +\n    'их база включает в конце и тогда же проверяет всё разом. Быстрее обычной загрузки в разы.',\n  setup: 'none',\n  tables: ['counts'],\n  covers: ['load.initial', 'error.not_empty', 'nuance.initial-empty-schema'],\n  steps: [\n    {\n      title: 'Свежая установка и модель',\n      run: async ({ schema, dsn, connect }) => {\n        const r = await up({ dsn: dsn.admin, schema, fresh: true, quiet: true, tenant: { name: 'Ромашка', user: { name: 'Анна', login: 'anna@romashka.ru', password: 'Ромашка-2026!' } } });\n        adm = await connect({ dsn: dsn.admin, schema: r.schema, token: r.tenant!.token!, allowBypassRls: true });\n        await syncShop(adm);\n        await adm.refresh();\n        return 'классы записаны — данных нет';\n      },\n    },\n    {\n      title: 'Залить магазин и 300 товаров',\n      run: async () => adm.load({\n        Shop: [{ name: 'Ромашка' }],\n        Product: Array.from({ length: 300 }, (_, i) => ({ sku: `P-${i + 1}`, title: `Товар ${i + 1}`, price: 100 + i, Shop: { $key: ['Ромашка'] } })),\n      }, { initial: true }),\n    },\n    {\n      title: 'Вторая первая заливка — нельзя',\n      text: 'Схема должна быть пустой: допустимы только классы, аккаунты, членства и права.',\n      run: async () => adm.load({ Shop: [{ name: 'Лютик' }] }, { initial: true }),\n      expect: { error: 'not_empty' },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { up } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Db } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncShop } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/shop.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> adm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Db</span><span style=\"color:#2429