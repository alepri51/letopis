    {
      "title": "Установка с allowReset и класс с политикой",
      "text": "`maintain({ now })` — «как будто сейчас другое время» — работает только в установке с `allowReset`: это стенд, а не рабочая установка.",
      "code": "const r = await up({ dsn: dsn.admin, schema, fresh: true, quiet: true, allowReset: true, tenant: { name: 'Ромашка', user: { name: 'Анна', login: 'anna@romashka.ru', password: 'Ромашка-2026!' } } });\nadm = await connect({ dsn: dsn.admin, schema: r.schema, token: r.tenant!.token!, allowBypassRls: true });\nawait syncModels(adm, [Gauge], { apply: true });\nawait adm.refresh();\nreturn adm.registry.resolve('Gauge').history;",
