    {
      "title": "Второй фактор: TOTP",
      "text": "`enrollTotp` даёт секрет и адрес `otpauth://` для QR-кода; первая верная проверка включает фактор. `totpCode` — помощник для тестов.",
      "code": "({ secret } = await svc.auth.enrollTotp({ account: up.tenant!.user!, issuer: 'Ромашка' }));\nconst ok = await svc.auth.verifyTotp({ account: up.tenant!.user!, code: totpCode(secret) });\nreturn { 'код принят': ok, 'TOTP включён': await svc.auth.totpEnabled(up.tenant!.user!) };",
