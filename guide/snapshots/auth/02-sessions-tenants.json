{
  "id": "auth/02-sessions-tenants",
  "title": "Сессии и арендаторы: переключение, креды, выход, закрытие арендатора",
  "summary": "Сессия входа сначала работает в личном арендаторе учётной записи, в компанию её переводит auth.switch(). Креды видны без секретов, сессию можно продлить и погасить — одну или все. Владелец может стереть арендатора целиком, даже тот, в котором сейчас работает.",
  "covers": [
    "auth.tenants",
    "auth.switch",
    "auth.credentials",
    "auth.issueKeySecret",
    "auth.verifyKeySecret",
    "auth.setFlags",
    "auth.refresh",
    "auth.revoke",
    "auth.revokeAll",
    "auth.purgeAccount",
    "nuance.session-starts-personal",
    "nuance.purge-current-tenant",
    "nuance.service-enforces-2fa",
    "nuance.refresh-never-shortens",
    "nuance.revoked-session-empty"
  ],
  "tables": [
    "secret"
  ],
  "initial": {
    "entity": [],
    "log": [],
    "secret": [],
    "counts": null
  },
  "steps": [
    {
      "title": "Вход паролем: сессия в личном арендаторе",
      "text": "У каждой учётной записи есть свой, личный арендатор; свежая сессия работает в нём. `auth.tenants()` — куда можно перейти: личный (роль `owner`) и компании по членству.",
      "code": "\nconst ok = (await svc.auth.verifyPassword({ identifier: user.login, password: user.password }))!;\r\nanna = await connect({ dsn: dsn.app, schema, token: ok.token });\r\nreturn { 'сейчас': anna.tenant === ok.account ? 'личный арендатор' : anna.tenant, 'можно': await anna.auth.tenants(), 'компания': up.tenant!.tenant };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> ok</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> svc.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">verifyPassword</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ identifier: user.login, password: user.password }))</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">anna </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> connect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ dsn: dsn.app, schema, token: ok.token });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'сейчас'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: anna.tenant </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ok.account </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">?</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'личный арендатор'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> anna.tenant, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'можно'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> anna.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tenants</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'компания'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: up.tenant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.tenant };</span></span></code></pre>",
