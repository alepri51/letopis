    {
      "title": "Пара «ключ + секрет» и её отключение",
      "text": "Для интеграций, которым нужен отдельный секрет. `setFlags(id, { enabled: false })` выключает кред, не удаляя его.",
      "code": "\nconst issued = await svc.auth.issueKeySecret({ account: up.tenant!.user!, name: 'склад' });\r\npair = { key: issued.key, secret: issued.secret }; pairId = issued.id;\r\nconst before = !!(await svc.auth.verifyKeySecret(pair.key, pair.secret));\r\nconst wrong = await svc.auth.verifyKeySecret(pair.key, 'не тот секрет');\r\nawait svc.auth.setFlags(pairId, { enabled: false });\r\nreturn { 'вход парой': before, 'неверный секрет': wrong, 'после отключения': await svc.auth.verifyKeySecret(pair.key, pair.secret) };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> issued</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> svc.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">issueKeySecret</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ account: up.tenant</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.user</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'склад'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">pair </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { key: issued.key, secret: issued.secret }; pairId </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> issued.id;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> before</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> svc.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">verifyKeySecret</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pair.key, pair.secret));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> wrong</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> svc.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">verifyKeySecret</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pair.key, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'не тот секрет'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> svc.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setFlags</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pairId, { enabled: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'вход парой'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: before, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'неверный секрет'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: wrong, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'после отключения'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> svc.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">verifyKeySecret</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(pair.key, pair.secret)