{
  "id": "ops/02-reset",
  "title": "Сброс: reset({ level }) — сессии, данные арендатора, всё",
  "summary": "reset — для стендов и тестов: завершить все сессии, стереть данные арендатора или всю установку. Включается только флагом установки allowReset, требует права letopis.reset и подтверждения именем схемы.",
  "covers": [
    "db.reset",
    "reset.level",
    "reset.confirm",
    "reset.tenant",
    "error.reset_disabled",
    "error.confirm_mismatch",
    "error.tenant_denied",
    "nuance.reset-tenant-memberships"
  ],
  "tables": [
    "counts"
  ],
  "context": {
    "schema": "v2.g_ops_02_reset",
    "dsn": {
      "admin": "postgres://postgres:test@localhost:15433/letopis",
      "app": "postgres://letopis_test_app:test@localhost:15433/letopis"
    },
    "user": {
      "login": "anna@romashka.ru",
      "password": "Ромашка-2026!"
    },
    "up": null
  },
  "source": "import { up } from 'letopis';\r\nimport type { Db } from 'letopis';\r\nimport { example } from '../../kit/example.ts';\r\nimport { syncShop } from '../../kit/shop.ts';\r\n\r\nlet adm: Db, tenant: string;\r\nconst TENANT = { name: 'Ромашка', user: { name: 'Анна', login: 'anna@romashka.ru', password: 'Ромашка-2026!' } };\r\n\r\nexport default example({\r\n  title: 'Сброс: reset({ level }) — сессии, данные арендатора, всё',\r\n  summary:\r\n    'reset — для стендов и тестов: завершить все сессии, стереть данные арендатора или всю установку. ' +\r\n    'Включается только флагом установки allowReset, требует права letopis.reset и подтверждения именем схемы.',\r\n  setup: 'none',\r\n  tables: ['counts'],\r\n  covers: ['db.reset', 'reset.level', 'reset.confirm', 'reset.tenant', 'error.reset_disabled', 'error.confirm_mismatch', 'error.tenant_denied', 'nuance.reset-tenant-memberships'],\r\n  steps: [\r\n    {\r\n      title: 'Установка без allowReset — сброс выключен',\r\n      run: async ({ schema, dsn, connect: track }) => {\r\n        const r = await up({ dsn: dsn.admin, schema, fresh: true, quiet: true, tenant: TENANT });\r\n        tenant = r.tenant!.tenant;\r\n        adm = await track({ dsn: dsn.admin, schema: r.schema, token: r.tenant!.token!, allowBypassRls: true });\r\n        return adm.reset({ level: 'sessions', confirm: r.schema });\r\n      },\r\n      expect: { error: 'reset_disabled' },\r\n    },\r\n    {\r\n      title: 'up() с allowReset; неверное подтверждение',\r\n      text: 'Флаг хранится в установке, и каждый вызов `up()` задаёт его заново. `confirm` — полное имя схемы.',\r\n      run: async ({ schema, dsn }) => {\r\n        await up({ dsn: dsn.admin, schema, quiet: true, allowReset: true });\r\n        return adm.reset({ level: 'sessions', confirm: 'не та схема' });\r\n      },\r\n      expect: { error: 'confirm_mismatch' },\r\n    },\r\n    {\r\n      title: 'Завершить все сессии, кроме текущей',\r\n      run: async ({ schema }) => adm.reset({ level: 'sessions', confirm: schema }),\r\n    },\r\n    {\r\n      title: 'Стереть данные арендатора',\r\n      text: 'Строки и журнал арендатора стираются пачками; аккаунт, способы входа и сессии остаются. В журнале — запись `reset`.',\r\n      run: async ({ schema }) => {\r\n        await syncShop(adm);\r\n        await adm.refresh();\r\n        await adm.Shop().create({ name: 'Ромашка' }).rows();\r\n        return adm.reset({ level: 'tenant', tenant, confirm: schema });\r\n      },\r\n    },\r\n    {\r\n      title: 'Сессия в стёртом арендаторе больше не работает',\r\n      text: 'Членства — тоже данные арендатора: `reset` их стёр, и сессия Анны в «Ромашке» получает `tenant_denied`.',\r\n      run: async () => adm.Shop().count(),\r\n      expect: { error: 'tenant_denied' },\r\n    },\r\n    {\r\n      title: 'Стереть всё: классы, данные, способы входа, сессии',\r\n      text: 'Администраторское подключение без сессии (право — у администраторской роли). Остаётся пустая установка с новым ключом сервиса.',\r\n      run: async ({ schema, dsn, connect: track }) => {\r\n        const root = await track({ dsn: dsn.admin, schema, allowBypassRls: true });\r\n        const res = await root.reset({ level: 'all', confirm: schema });\r\n        return { ...res, serviceKey: res.serviceKey ? 'новый ключ lts_…' : null };\r\n      },\r\n    },\r\n  ],\r\n});\r\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { up } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { Db } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncShop } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/shop.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> adm</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Db</span><span style=\"color:#2429