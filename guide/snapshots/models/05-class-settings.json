  "source": "import { syncModels, describeText } from 'letopis';\nimport { hub } from 'letopis/model';\nimport { z } from 'zod';\nimport { example } from '../../kit/example.ts';\n\nconst Ping = hub('Ping', { fields: { source: z.string() }, history: false }); // журнал не ведётся\nconst Draft = hub('Draft', { fields: { text: z.string() }, ownerDefault: 'actor' }); // владелец — автор\nconst Product = hub('Product', { fields: { title: z.string() }, meta: { title: 'Товар', icon: 'mdi:package-variant', order: 1 } });\nlet ping: { id: string };\n\nexport default example({\n  title: 'Настройки класса: без истории, владелец-автор, метаданные, описание модели',\n  summary:\n    'history: false выключает журнал класса. ownerDefault: \\'actor\\' делает владельцем новой строки самого ' +\n    'пользователя. meta — свободные метаданные для интерфейса. db.describe() отдаёт описание всей модели.',\n  covers: ['class.history', 'class.ownerDefault', 'db.describe', 'export.describeText', 'nuance.history-false'],\n  steps: [\n    {\n      title: 'Три класса с настройками',\n      run: async ({ db }) => (await syncModels(db, [Ping, Draft, Product], { apply: true })).created,\n    },\n    {\n      title: 'Класс без истории: журнал пуст',\n      text:\n        'Строка `Ping` есть в `entity`, а в журнале `log` для неё ничего нет: у класса `history: false`. ' +\n        'Нет версий, среза на дату, восстановления и событий подписки — зато запись дешевле. `versions()` ' +\n        'вернёт пустой список и предупредит в консоли.',\n      run: async ({ db, warnings }) => {\n        [ping] = await db.Ping().create({ source: 'датчик-1' }).rows();\n        await db.Ping(ping).update({ source: 'датчик-2' }).rows();\n        const { result: versions, warnings: printed } = await warnings(() => db.Ping(ping).versions());\n        return { versions, printed };\n      },\n    },\n    {\n      title: 'Владелец — автор, а не арендатор',\n      text:\n        'У обычной строки владелец — арендатор («Ромашка»). У класса с `ownerDefault: \\'actor\\'` владелец — ' +\n        'пользователь, который её создал. Это пригодится для правила «каждый видит свои черновики».',\n      run: async ({ db }) => {\n        const [draft] = await db.Draft().create({ text: 'План на неделю' }).rows();\n        const [product] = await db.Product().create({ title: 'Чайник' }).rows();\n        return { draftOwner: draft.owner, productOwner: product.owner };\n      },\n    },\n    {\n      title: 'Описание модели для интерфейса',\n      text: '`db.describe()` отдаёт классы с полями и метаданными; `describeText` — то же коротким текстом (удобно вставить в запрос к ИИ).',\n      run: async ({ db }) => {\n        const d = await db.describe();\n        const product = d.classes.find((c) => c.name === 'Product');\n        return { productMeta: product?.meta, text: describeText(d).split('\\n').filter((l) => /Product|Ping|Draft/.test(l)) };\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncModels, describeText } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hub } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Ping</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"co