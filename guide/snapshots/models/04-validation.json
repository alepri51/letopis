  "source": "import { syncModels } from 'letopis';\nimport { hub } from 'letopis/model';\nimport { z } from 'zod';\nimport { example } from '../../kit/example.ts';\n\nconst Product = hub('Product', {\n  title: z.string(),\n  price: z.number().int().min(0),\n  status: z.enum(['draft', 'active']).default('draft'),\n}, {});\n// та же модель с новым обязательным полем — ужесточение\nconst ProductV2 = hub('Product', {\n  title: z.string(),\n  price: z.number().int().min(0),\n  status: z.enum(['draft', 'active']).default('draft'),\n  sku: z.string(),\n}, {});\n// новое необязательное поле — безопасное изменение\nconst ProductV3 = hub('Product', {\n  title: z.string(),\n  price: z.number().int().min(0),\n  status: z.enum(['draft', 'active']).default('draft'),\n  note: z.string().optional(),\n}, {});\n// правило refine база выразить не может\nconst Coupon = hub('Coupon', { code: z.string().refine((s) => s.startsWith('C-'), 'код начинается с C-') }, {});\n\nexport default example({\n  title: 'Проверка данных: база не примет неправильное',\n  summary:\n    'Модель превращается в JSON Schema, и каждую запись проверяет сама база — даже запись прямым SQL-запросом. ' +\n    'Значения по умолчанию подставляет база. Новое обязательное поле ужесточает модель: база проверит, подходят ли ' +\n    'под неё старые строки.',\n  covers: ['error.invalid_data', 'error.tightening_conflict', 'nuance.refine-lost', 'nuance.defaults-by-db', 'nuance.safe-change'],\n  steps: [\n    {\n      title: 'Класс «Товар»',\n      run: async ({ db }) => (await syncModels(db, [Product], { apply: true })).created,\n    },\n    {\n      title: 'Значение по умолчанию подставляет база',\n      text: 'Поле `status` не передали — база подставила `draft` из `.default()` модели.',\n      run: async ({ db }) => db.Product().create({ title: 'Чайник', price: 2500 }).rows(),\n    },\n    {\n      title: 'Отрицательная цена — отказ',\n      text: 'Цена по модели — целое число не меньше 0. Строка с `-1` в базу не попадёт: `invalid_data`, данные не изменились.',\n      run: async ({ db }) => db.Product().create({ title: 'Кружка', price: -1 }).rows(),\n      expect: { error: 'invalid_data' },\n    },\n    {\n      title: 'Новое обязательное поле — ужесточение',\n      text:\n        'У «Чайника» нет поля `sku`, а модель теперь требует его. Такое изменение — ужесточение: старые данные могут ' +\n        'под него не подойти. База проверяет все строки класса и отвечает `tightening_conflict` со списком строк, ' +\n        'которые не подходят. Описание класса не изменилось.',\n      run: async ({ db }) => syncModels(db, [ProductV2], { apply: true }),\n      expect: { error: 'tightening_conflict' },\n    },\n    {\n      title: 'Необязательное поле — безопасно',\n      text: 'Новое необязательное поле старым строкам не мешает — изменение применяется сразу (`updated`).',\n      run: async ({ db }) => {\n        const r = await syncModels(db, [ProductV3], { apply: true });\n        return { updated: r.updated };\n      },\n    },\n    {\n      title: 'Проверки refine база не выполняет',\n      text:\n        '`refine`, `superRefine` и `transform` в JSON Schema не выражаются. `syncModels` не теряет их молча: ' +\n        'возвращает в `lost`. Такие проверки выполняйте в приложении.',\n      run: async ({ db }) => {\n        const r = await syncModels(db, [Coupon], { apply: true });\n        return { created: r.created, lost: r.lost };\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncModels } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hub } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Product</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62