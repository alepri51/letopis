  },
  "source": "import { syncModels, v5Id } from 'letopis';\nimport { hub } from 'letopis/model';\nimport { z } from 'zod';\nimport { randomUUID } from 'node:crypto';\nimport { example } from '../../kit/example.ts';\n\nconst Shop = hub('Shop', { name: z.string() }, { key: ['name'] });\nconst Visitor = hub('Visitor', { name: z.string() }, {}); // без ключа\nconst Email = hub('Email', { address: z.string() }, { key: ['address'] });\nlet shop: { id: string };\n\nexport default example({\n  title: 'Ключ и id: что можно и чего нельзя',\n  summary:\n    'id объекта с ключом вычисляется из ключа (UUID версии 5), поэтому его не передают. Объект без ключа получает ' +\n    'случайный id. Ключ нельзя поменять правкой — новый ключ значит новый объект.',\n  covers: [\n    'export.v5Id', 'error.immutable_key', 'nuance.key-case', 'nuance.keyless-repeat', 'nuance.no-id-in-create',\n  ],\n  steps: [\n    {\n      title: 'Классы и магазин',\n      run: async ({ db }) => {\n        await syncModels(db, [Shop, Visitor, Email], { apply: true });\n        [shop] = await db.Shop().create({ name: 'Ромашка' }).rows();\n        return shop;\n      },\n    },\n    {\n      title: 'id можно вычислить даже без базы',\n      text:\n        '`v5Id(арендатор, класс, значения ключа)` — та же формула, что в базе. Значит, приложение знает id заранее ' +\n        'и может ссылаться на объект, не читая его.',\n      run: async ({ db }) => v5Id(db.tenant!, 'Shop', ['Ромашка']) === shop.id,\n    },\n    {\n      title: 'id в create не передают',\n      text:\n        'id объекта с ключом вычисляет база, у объекта без ключа — выдаёт база. Поле `id` в данных `create` — ' +\n        'лишнее поле, которого нет в описании класса, поэтому отказ `invalid_data`. (Коды `id_mismatch` и ' +\n        '`id_from_db` — в главе про ошибки.)',\n      run: async ({ db }) => db.Shop().create({ id: randomUUID(), name: 'Лютик' }).rows(),\n      expect: { error: 'invalid_data' },\n    },\n    {\n      title: 'Без ключа повтор создаёт второй объект',\n      text:\n        'Класс без ключа не защищён от повтора: две одинаковые записи — два разных объекта. Если повтор после сбоя ' +\n        'сети возможен, давайте классу ключ.',\n      run: async ({ db }) => {\n        await db.Visitor().create({ name: 'Пётр' }).rows();\n        await db.Visitor().create({ name: 'Пётр' }).rows();\n        return db.Visitor().count();\n      },\n    },\n    {\n      title: 'Ключ правкой не меняется',\n      text: 'Поле ключа нельзя изменить правкой (`immutable_key`): новый ключ — это новый id, то есть новый объект. Его создают, переводят на него концы других строк и удаляют прежний (глава «Запись», «Ключ и класс неизменны»).',\n      run: async ({ db }) => db.Shop(shop).update({ name: 'Лютик' }).rows(),\n      expect: { error: 'immutable_key' },\n    },\n    {\n      title: 'Регистр важен',\n      text:\n        'Значения ключа берутся как есть: `Anna@Mail.ru` и `anna@mail.ru` дают разные id. Приводите такие ' +\n        'значения к одному виду в приложении или задайте формат в модели.',\n      run: async ({ db }) => (await db.idOf('Email', { address: 'Anna@Mail.ru' })) !== (await db.idOf('Email', { address: 'anna@mail.ru' })),\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncModels, v5Id } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hub } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { randomUUID } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'node:crypto'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Shop</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Shop'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { name: z.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }, { key: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'name'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Visitor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Visitor'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { name: z.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }, {}); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// без ключа</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> Email</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> hub</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Email'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { address: z.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">string</span><span style=\"color:#24292E;--shiki-dark:#E1E4