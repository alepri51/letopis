{
  "id": "models/02-keys-and-ids",
  "title": "Ключ и id: что можно и чего нельзя",
  "summary": "id объекта с ключом вычисляется из ключа (UUID версии 5), поэтому его не передают. Объект без ключа получает случайный id. Ключ нельзя поменять правкой — новый ключ значит новый объект.",
  "covers": [
    "export.v5Id",
    "error.immutable_key",
    "nuance.key-case",
    "nuance.keyless-repeat",
    "nuance.no-id-in-create"
  ],
  "tables": [
    "entity",
    "log"
  ],
  "context": {
    "schema": "v2.g_models_02_keys_and_ids",
    "dsn": {
      "admin": "postgres://postgres:test@localhost:15433/letopis",
      "app": "postgres://letopis_test_app:test@localhost:15433/letopis"
    },
    "user": {
      "login": "anna@romashka.ru",
      "password": "Ромашка-2026!"
    },
    "up": {
      "serviceKey": "‹токен 1›",
      "tenant": {
        "tenant": "Ромашка",
        "user": "Анна",
        "token": "‹токен 2›",
        "created": true
      }
