    "model.hub",
    "model.link",
    "model.one",
    "model.many",
    "class.key",
    "class.ends",
    "class.meta",
    "class.onDelete",
    "db.idOf",
    "chain.create",
    "error.exists",
    "nuance.sync-dry-run"
  ],
  "tables": [
    "entity",
    "log"
  ],
