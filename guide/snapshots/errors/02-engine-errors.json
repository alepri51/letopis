{
  "id": "errors/02-engine-errors",
  "title": "Ошибки базы: что ловят триггеры при записи в обход библиотеки",
  "summary": "Правила целостности проверяет сама база — для библиотеки и для сырого SQL одинаково. Здесь запись идёт сырым SQL под сессией (db.transaction) — и база отвечает теми же кодами, что цепочкам.",
  "covers": [
    "error.undeclared_end",
    "error.id_from_db",
    "error.use_reclass",
    "error.recreated_in_statement",
    "error.isolation_level",
    "nuance.engine-checks-raw-sql",
    "export.fromDbError"
  ],
