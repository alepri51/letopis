  "source": "import { example } from '../../kit/example.ts';\nimport { syncShop } from '../../kit/shop.ts';\n\nlet shop: { id: string }, cursor: string;\n\nexport default example({\n  title: 'Подписка на изменения: по курсору, без потерь и повторов',\n  summary:\n    'db.watch() отдаёт изменения классов по порядку журнала. У каждого события есть курсор: запомнили его — ' +\n    'и после перезапуска процесса продолжили с того же места, ничего не потеряв и не получив дважды.',\n  tables: [],\n  covers: ['db.watch', 'watch.from', 'watch.classes', 'nuance.watch-cursor-resume'],\n  steps: [\n    {\n      title: 'Магазин и два товара',\n      run: async ({ db }) => {\n        await syncShop(db); // скрыть\n        [shop] = await db.Shop().create({ name: 'Ромашка' }).rows();\n        await db.Shop(shop).Product().create({ sku: 'K-1', title: 'Чайник', price: 2500 }).rows();\n        await db.Shop(shop).Product().create({ sku: 'M-1', title: 'Кружка', price: 400 }).rows();\n        return 'готово';\n      },\n    },\n    {\n      title: 'Подписка с начала журнала',\n      text: '`from: \\'start\\'` — все сохранённые изменения товаров. Берём два события и запоминаем курсор последнего.',\n      run: async ({ db }) => {\n        const sub = db.watch({ from: 'start', classes: ['Product'] });\n        const got = [];\n        for (let i = 0; i < 2; i++) {\n          const ev = (await sub.next()).value;\n          got.push({ op: ev.op, title: ev.row.data.title, rev: ev.rev });\n          cursor = ev.cursor;\n        }\n        await sub.close();\n        return got;\n      },\n    },\n    {\n      title: 'Пока подписки нет — изменение',\n      run: async ({ db }) => db.Shop(shop).Product({ sku: 'K-1' }).update({ price: 1990 }).rows(),\n    },\n    {\n      title: 'Продолжить с курсора',\n      text: 'Новая подписка с запомненного курсора получает ровно то, что случилось после него, — правку Чайника.',\n      run: async ({ db }) => {\n        const sub = db.watch({ from: cursor, classes: ['Product'] });\n        const ev = (await sub.next()).value;\n        await sub.close();\n        return { op: ev.op, title: ev.row.data.title, price: ev.row.data.price, rev: ev.rev };\n      },\n    },\n    {\n      title: 'Цикл for await, отставание и выход из цикла',\n      text:\n        '`for await (const ev of sub)` выдаёт события по одному. Выход из цикла (`break`) сам вызывает `sub.return()`: ' +\n        'подписка закрыта, следующий `next()` отвечает `done: true`. `sub.lag()` — сколько миллисекунд ждёт самое ' +\n        'старое записанное событие, которое ещё задерживает более старая открытая транзакция; 0 — ждать нечего.',\n      run: async ({ db }) => {\n        const sub = db.watch({ from: 'start', classes: ['Product'] });\n        await sub.ready();\n        const got: string[] = [];\n        for await (const ev of sub) {\n          got.push(`${ev.op} ${ev.row.data.title}`);\n          if (got.length === 3) break;\n        }\n        return { 'события': got, 'ждать нечего (lag = 0)': (await sub.lag()) === 0, 'после break: done': (await sub.next()).done };\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { syncShop } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/shop.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> shop</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }, cursor</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><spa