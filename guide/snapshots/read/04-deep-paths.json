  "source": "import { example } from '../../kit/example.ts';\nimport { seedShop, type ShopData } from '../../kit/shop.ts';\n\nlet d: ShopData;\n\nexport default example({\n  title: 'Деревья, пути и подсчёт путей',\n  summary:\n    'deep() идёт вглубь дерева на любую глубину. paths() отдаёт не только конечные строки, а весь путь: узел на ' +\n    'каждый шаг. .alias(имя) переименовывает узел пути.',\n  tables: [],\n  covers: ['chain.deep', 'chain.paths', 'chain.alias', 'nuance.count-paths'],\n  steps: [\n    {\n      title: 'Данные и ещё один уровень дерева',\n      text: 'Добавляем «Улун» внутрь «Зелёного чая»: дерево «Чай» → «Зелёный чай» → «Улун».',\n      run: async ({ db }) => {\n        d = await seedShop(db);\n        return db.Category().create({ name: 'Улун' }).Parent.set(d.green).rows();\n      },\n    },\n    {\n      title: 'Поддерево любой глубины',\n      text: 'Шаг к тому же классу ведёт к дочерним узлам дерева. `deep()` повторяет его до конца дерева; `$depth` — уровень вложенности.',\n      run: async ({ db }) => (await db.Category(d.tea).Category().deep().rows()).map((c) => ({ name: c.data.name, depth: c.$depth })),\n    },\n    {\n      title: 'Пути: заказ → строка → товар',\n      text: '`paths()` отдаёт варианты пути целиком: для каждой строки заказа — и строку, и её товар.',\n      run: async ({ db }) =>\n        (await db.Order(d.order1).line().Product().paths()).map((p) => ({ qty: p.line.data.qty, product: p.Product.data.title })),\n    },\n    {\n      title: 'Свои имена узлов: alias',\n      run: async ({ db }) =>\n        (await db.Order(d.order1).line().alias('позиция').Product().alias('товар').paths()).map((p) => ({\n          qty: (p['позиция'] as { data: Record<string, unknown> }).data.qty,\n          product: (p['товар'] as { data: Record<string, unknown> }).data.title,\n        })),\n    },\n    {\n      title: 'count() и count({ paths: true })',\n      text:\n        'Оба заказа — из «Ромашки». `count()` считает каждый объект последнего шага один раз — магазин один; ' +\n        '`count({ paths: true })` — сколько путей к ним ведёт: два, по одному от каждого заказа.',\n      run: async ({ db }) => ({\n        'магазинов у заказов': await db.Order().Shop().count(),\n        'путей до них': await db.Order().Shop().count({ paths: true }),\n      }),\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { seedShop, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ShopData } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/shop.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> d</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ShopData</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Деревья, пути и подсчёт путей'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><