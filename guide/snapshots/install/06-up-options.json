{
  "id": "install/06-up-options",
  "title": "Опции up(): свой пул, роли, миграции, первый арендатор, режим сигналов none",
  "summary": "up() может работать через готовый пул postgres.js (sql), с другими именами ролей (owner, app), своим каталогом миграций (migrationsDir) и сразу завести первого арендатора (tenant). Режим сигналов none — для пулов в режиме транзакций (PgBouncer): база не шлёт сигналы (NOTIFY), поэтому кэш выключен — включить его можно только по сроку (ttlOnly).",
  "covers": [
    "up.sql",
    "up.tenant",
    "up.owner",
    "up.app",
    "up.migrationsDir",
    "signals.none",
    "model.End",
    "model.normalizeSchema",
    "model.translatePattern"
  ],
  "tables": [
    "counts"
  ],
  "context": {
    "schema": "v2.g_install_06_up_options",
    "dsn": {
      "admin": "postgres://postgres:test@localhost:15433/letopis",
      "app": "postgres://letopis_test_app:test@localhost:15433/letopis"
    },
    "user": {
      "login": "anna@romashka.ru",
      "password": "Ромашка-2026!"
    },
    "up": null
  },
  "source": "import { fileURLToPath } from 'node:url';\nimport { up } from 'letopis';\nimport { End, one, hub, normalizeSchema, translatePattern } from 'letopis/model';\nimport { z } from 'zod';\nimport { example } from '../../kit/example.ts';\n\nconst MIGRATIONS = fileURLToPath(new URL('../../../lib/sql/migrate', import.meta.url));\n\nexport default example({\n  title: 'Опции up(): свой пул, роли, миграции, первый арендатор, режим сигналов none',\n  summary:\n    'up() может работать через готовый пул postgres.js (sql), с другими именами ролей (owner, app), своим ' +\n    'каталогом миграций (migrationsDir) и сразу завести первого арендатора (tenant). Режим сигналов none — для ' +\n    'пулов в режиме транзакций (PgBouncer): база не шлёт сигналы (NOTIFY), поэтому кэш выключен — включить его можно ' +\n    'только по сроку (ttlOnly).',\n  setup: 'none',\n  tables: ['counts'],\n  covers: ['up.sql', 'up.tenant', 'up.owner', 'up.app', 'up.migrationsDir', 'signals.none', 'model.End', 'model.normalizeSchema', 'model.translatePattern'],\n  steps: [\n    {\n      title: 'Установка через готовый пул, с ролями по умолчанию и первым арендатором',\n      run: async ({ admin, schema }) => {\n        const r = await up({\n          sql: admin as never, schema, fresh: true, quiet: true, owner: 'letopis_owner', app: 'letopis_app', migrationsDir: MIGRATIONS,\n          signals: 'none', tenant: { name: 'Ромашка', user: { name: 'Анна', login: 'anna@romashka.ru', password: 'Ромашка-2026!' } },\n        });\n        return { created: r.created, revision: r.revision, 'арендатор создан': r.tenant!.created, signals: (r as { signals?: string }).signals ?? 'none' };\n      },\n    },\n    {\n      title: 'Режим none: подключение не слушает сигналы, кэш выключен',\n      run: async ({ connect, dsn, schema }) => {\n        const r = await up({ dsn: dsn.admin, schema, quiet: true, tenant: { name: 'Ромашка', user: { name: 'Анна', login: 'anna@romashka.ru', password: 'Ромашка-2026!' } } });\n        const db = await connect({ dsn: dsn.app, schema, token: r.tenant!.token! });\n        return { 'кэш включён': db.cache.stats().enabled, 'слушателей': db.cache.stats().listens };\n      },\n    },\n    {\n      title: 'Помощники схемы из letopis/model',\n      text: '`one(…)` и `many(…)` — концы (`End`); `normalizeSchema` приводит JSON Schema к виду, который понимает база; `translatePattern` переводит регулярное выражение в синтаксис jsonpath.',\n      run: async () => {\n        const Shop = hub('Shop', { name: z.string() }, { key: ['name'] });\n        return {\n          'one(Shop) — End': one(Shop) instanceof End,\n          'normalizeSchema': normalizeSchema({ type: 'object', properties: { n: { type: 'integer', minimum: 1 } } }),\n          'translatePattern': translatePattern('^\\\\d{3}$'),\n        };\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { fileURLToPath } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'node:url'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { up } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { End, one, hub, normalizeSchema, translatePattern } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span