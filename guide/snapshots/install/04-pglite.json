  "source": "import { up, connect, syncModels } from 'letopis';\nimport type { UpResult, Db } from 'letopis';\nimport { hub } from 'letopis/model';\nimport { z } from 'zod';\nimport { example } from '../../kit/example.ts';\n\nconst Task = hub('Task', { fields: { title: z.string(), done: z.boolean() } });\nlet dev: UpResult;\nlet local: Db;\n\nexport default example({\n  title: 'Разработка без PostgreSQL: PGlite',\n  summary:\n    'PGlite — PostgreSQL 18, собранный в WebAssembly: работает внутри процесса Node, ставить сервер не нужно. ' +\n    'Удобно для разработки и демонстраций. Для проверки прав, одновременных транзакций и CI он не годится: соединение одно, RLS не действует.',\n  setup: 'none',\n  tables: [],\n  covers: ['up.pglite', 'nuance.pglite-no-rls'],\n  steps: [\n    {\n      title: 'Запускаем PGlite и ставим схему',\n      text:\n        '`up({ pglite: true })` запускает PGlite с сокетом на свободном порту и ставит в него схему. Строка ' +\n        'подключения — `dev.pglite.dsn`. Нужны пакеты `@electric-sql/pglite` и `@electric-sql/pglite-socket`.',\n      run: async () => {\n        dev = await up({ schema: 'dev', pglite: true, quiet: true });\n        return { schema: dev.schema, created: dev.created, pglite: !!dev.pglite };\n      },\n    },\n    {\n      title: 'Подключаемся: одно соединение, без LISTEN',\n      text:\n        'Соединение у PGlite одно, поэтому `max: 1` и `listen: false`. Подключение идёт от суперпользователя, ' +\n        'поэтому нужно `allowBypassRls: true`: изоляцию арендаторов и права на PGlite не проверить.',\n      run: async ({ warnings }) => {\n        const { result } = await warnings(() =>\n          connect({ dsn: dev.pglite!.dsn, schema: dev.schema, apiKey: dev.serviceKey!, listen: false, max: 1, allowBypassRls: true }));\n        local = result;\n        await syncModels(local, [Task], { apply: true });\n        await local.Task().create({ title: 'Написать документацию', done: false }).rows();\n        return (await local.Task().rows()).map((t) => t.data);\n      },\n    },\n    {\n      title: 'Закрываем подключение и PGlite',\n      run: async () => {\n        await local.close();\n        await dev.pglite!.close();\n        return 'закрыто';\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { up, connect, syncModels } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { UpResult, Db } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { hub } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis/model'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { z } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'zod'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#