  "steps": [
    {
      "title": "Поднимаем PGlite и ставим схему",
      "text": "`up({ pglite: true })` поднимает PGlite с сокетом на свободном порту и ставит в него схему. Строка подключения — `dev.pglite.dsn`. Нужны пакеты `@electric-sql/pglite` и `@electric-sql/pglite-socket`.",
      "code": "dev = await up({ schema: 'dev', pglite: true, quiet: true });\nreturn { schema: dev.schema, created: dev.created, pglite: !!dev.pglite };",
      "html": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dev </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> up</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ schema: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'dev'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, pglite: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, quiet: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { schema: dev.schema, created: dev.created, pglite: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">!!</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dev.pglite };</span></span></code></pre>",
      "result": {
        "schema": "v2.dev",
        "created": true,
        "pglite": true
      },
      "error": null,
      "entity": [],
      "removed": [],
      "log": [],
