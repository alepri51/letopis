{
  "id": "install/02-up-options",
  "title": "Опции up(): сиды, режим сигналов, свой ключ, история, обновление, установка заново",
  "summary": "up() настраивает установку опциями. Часть настроек хранится в самой схеме (режим сигналов), поэтому повторный up() без опции их не меняет. fresh ставит схему заново и стирает данные.",
  "covers": [
    "up.seeds",
    "up.signals",
    "up.serviceKey",
    "up.allowReset",
    "up.history",
    "up.upgrade",
    "up.fresh",
    "up.waitTimeoutMs",
    "signals.tenant",
    "signals.opaque",
    "nuance.signals-mode-sticky",
    "nuance.fresh-drops-data"
  ],
  "tables": [
    "counts"
  ],
  "context": {
    "schema": "v2.g_install_02_up_options",
    "dsn": {
      "admin": "postgres://postgres:test@localhost:15433/letopis",
      "app": "postgres://letopis_test_app:test@localhost:15433/letopis"
    },
    "user": {
      "login": "anna@romashka.ru",
      "password": "Ромашка-2026!"
    },
    "up": null
  },
  "source": "import { up } from 'letopis';\nimport { example } from '../../kit/example.ts';\n\n// Свой ключ сервиса: lts_ и 32–128 шестнадцатеричных знаков.\nconst MY_KEY = 'lts_' + '0123456789abcdef'.repeat(2);\n\nexport default example({\n  title: 'Опции up(): сиды, режим сигналов, свой ключ, история, обновление, установка заново',\n  summary:\n    'up() настраивает установку опциями. Часть настроек хранится в самой схеме (режим сигналов), поэтому ' +\n    'повторный up() без опции их не меняет. fresh ставит схему заново и стирает данные.',\n  setup: 'none',\n  tables: ['counts'],\n  covers: [\n    'up.seeds', 'up.signals', 'up.serviceKey', 'up.allowReset', 'up.history', 'up.upgrade', 'up.fresh',\n    'up.waitTimeoutMs', 'signals.tenant', 'signals.opaque', 'nuance.signals-mode-sticky', 'nuance.fresh-drops-data',\n  ],\n  steps: [\n    {\n      title: 'Установка с готовой моделью салона и своими настройками',\n      text:\n        '`seeds: [\\'booking\\']` добавляет готовые классы салона (мастера, услуги, брони) — в сводке классов стало ' +\n        'больше. `signals` — режим сигналов, `serviceKey` — свой ключ вместо случайного, `allowReset` разрешает ' +\n        '`db.reset()`, `history` — политика хранения истории для классов без своей, `waitTimeoutMs` — сколько ждать базу.',\n      run: async ({ dsn, schema }) => {\n        const r = await up({\n          dsn: dsn.admin, schema, quiet: true, waitTimeoutMs: 10_000,\n          seeds: ['booking'],\n          signals: 'tenant',\n          serviceKey: MY_KEY,\n          allowReset: true,\n          history: { all: '1 day', daily: '1 week', weekly: '1 month', monthly: '1 year', yearly: 'forever', tz: 'Europe/Moscow' },\n        });\n        return { created: r.created, signals: r.signals, ourKey: r.serviceKey === MY_KEY };\n      },\n    },\n    {\n      title: 'Режим сигналов хранится в схеме',\n      text: 'Повторный `up()` без опции `signals` режим не трогает — он остался `tenant`.',\n      run: async ({ dsn, schema }) => {\n        const r = await up({ dsn: dsn.admin, schema, quiet: true });\n        return { signals: r.signals };\n      },\n    },\n    {\n      title: 'Сменить режим — только явно',\n      text:\n        'С опцией режим меняется: `opaque` скрывает из сигналов имена классов. После смены режима процессы ' +\n        'приложения перезапускают: режим читается при подключении.',\n      run: async ({ dsn, schema }) => {\n        const r = await up({ dsn: dsn.admin, schema, quiet: true, signals: 'opaque' });\n        return { signals: r.signals };\n      },\n    },\n    {\n      title: 'upgrade на свежей схеме ничего не делает',\n      text:\n        '`upgrade: true` нужен, когда новая версия пакета принесла новую ревизию схемы: тогда он применяет миграции — ' +\n        'SQL-скрипты, которые обновляют схему. ' +\n        'Здесь ревизия уже текущая — миграций нет, `upgraded: false`.',\n      run: async ({ dsn, schema }) => {\n        const r = await up({ dsn: dsn.admin, schema, quiet: true, upgrade: true });\n        return { upgraded: r.upgraded, revision: r.revision, migrations: r.migrations };\n      },\n    },\n    {\n      title: 'fresh — поставить заново (данные теряются)',\n      text:\n        '`fresh: true` удаляет схему и ставит её с нуля. Классы салона исчезли из сводки, потому что `seeds` не указан. ' +\n        'Ключ сервиса выдан новый — старый больше не работает.',\n      run: async ({ dsn, schema }) => {\n        const r = await up({ dsn: dsn.admin, schema, quiet: true, fresh: true });\n        return { created: r.created, signals: r.signals, newKey: r.serviceKey !== null && r.serviceKey !== MY_KEY };\n      },\n    },\n  ],\n});\n",
  "sourceHtml": "<pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { up } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'letopis'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { example } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">from</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '../../kit/example.ts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Свой ключ сервиса: lts_ и 32–128 шестнадцатеричных знаков.</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> MY_KEY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'lts_'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '0123456789abcdef'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">repeat</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> default</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> example</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Опции up(): сиды, режим сигналов, свой ключ, история, обновление, установка заново'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  summary:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'up() настраивает установку опциями. Часть настроек хранится в самой схеме (режим сигналов), поэтому '</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> +</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'повторный up() без опции их не меняет. fresh ставит схему заново и стирает данные.'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  setup: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'none'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  tables: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'counts'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  covers: [</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'up.seeds'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up.signals'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up.serviceKey'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up.allowReset'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up.history'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up.upgrade'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'up.fresh'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">    'up.waitTimeoutMs'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'signals.tenant'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'signals.opaque'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'nuance.signals-mode-sticky'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'nuance.fresh-drops-data'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  steps: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      title: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Установка с готовой моделью салона и своими настройками'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      text:</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">        '`seeds: [</span><span style=\"color:#005CC