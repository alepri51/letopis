{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "letopis": [
        "../lib/src/index.ts"
      ],
      "letopis/model": [
        "../lib/src/model.ts"
      ],
      "letopis/mcp": [
        "../lib/src/mcp.ts"
      ],
      "zod": [
        "../lib/node_modules/zod"
      ],
      "postgres": [
        "../lib/node_modules/postgres"
      ]
    }
  },
  "include": [
    "scripts",
    "coverage"
  ]
}
