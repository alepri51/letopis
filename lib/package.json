{
  "name": "letopis",
  "version": "4.0.0",
  "description": "Letopis (летопись): хранилище версионированных сущностей на PostgreSQL 18 — целостность, история, квартиры и права проверяет сама база, поверх — цепочки через точку. ИИ-агенту — AGENT-CHEATSHEET.md и llms.txt в пакете; исходный код доступен (PolyForm Noncommercial 1.0.0)",
  "keywords": [
    "postgres",
    "postgresql",
    "row-level-security",
    "versioning",
    "audit",
    "temporal",
    "asof",
    "graph",
    "jsonb",
    "multi-tenant",
    "acl",
    "uuidv5",
    "llms-txt",
    "ai-agents",
    "agent-cheatsheet"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepri51/letopis.git",
    "directory": "lib"
  },
  "homepage": "https://github.com/alepri51/letopis/tree/main/lib#readme",
  "bugs": "https://github.com/alepri51/letopis/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "letopis": "dist/cli.js"
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "AGENT-CHEATSHEET.md",
    "llms.txt",
    "api-contract.json",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-COMMERCIAL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:all": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "seed:booking": "tsx scripts/gen-seed-booking.mjs",
    "api:contract": "node scripts/gen-api-contract.mjs",
    "ops:tables": "tsx scripts/gen-ops-tables.mjs",
    "prepublishOnly": "npm run typecheck && npm run check:docs && npm run build",
    "check:semver": "node scripts/check-semver.mjs",
    "prerelease": "node scripts/prerelease.mjs",
    "cheatsheet": "node scripts/run-cheatsheet.mjs",
    "soak": "tsx bench/soak.mjs"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-socket": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "4.6.5"
  }
}
