{
  "name": "letopis",
  "version": "1.3.0-alpha.0",
  "description": "Letopis (летопись): versioned entity store on PostgreSQL 18 — integrity, history, tenants and access control enforced by the database itself, dot-notation chains on top",
  "keywords": [
    "postgres",
    "postgresql",
    "row-level-security",
    "versioning",
    "audit",
    "temporal",
    "asof",
    "graph",
    "jsonb",
    "multi-tenant",
    "acl",
    "uuidv5"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepri51/letopis.git",
    "directory": "lib"
  },
  "homepage": "https://github.com/alepri51/letopis/tree/main/lib#readme",
  "bugs": "https://github.com/alepri51/letopis/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "letopis": "dist/cli.js"
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "README.en.md",
    "AGENT-CHEATSHEET.md",
    "AGENT-CHEATSHEET.en.md",
    "llms.txt",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-force-exit test/*.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "seed:booking": "tsx scripts/gen-seed-booking.mjs",
    "test:import-salon": "tsx bench/import-salon.mjs",
    "api:contract": "node scripts/gen-api-contract.mjs",
    "prepublishOnly": "npm run typecheck && npm run check:docs && npm run build"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "zod": "^4",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-socket": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^22.20.5",
    "letopis-0": "npm:letopis@0.21.0",
    "letopis-1": "npm:letopis@1.0.1",
    "letopis-11": "npm:letopis@1.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "4.6.5"
  }
}
