{
  "name": "letopis",
  "version": "0.16.0",
  "description": "Letopis (летопись): append-only versioned entity store on TimescaleDB with dot-notation chains — every change is a new row, history is first-class (asOf, versions, watch, cascade tombstones)",
  "keywords": [
    "timescaledb",
    "postgres",
    "append-only",
    "immutable",
    "versioning",
    "audit",
    "temporal",
    "asof",
    "event-sourcing",
    "booking",
    "graph",
    "jsonb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepri51/letopis.git",
    "directory": "lib"
  },
  "homepage": "https://github.com/alepri51/letopis/tree/main/lib#readme",
  "bugs": "https://github.com/alepri51/letopis/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql",
    "docker",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-force-exit test/*.test.ts",
    "bench": "tsx bench/history.bench.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "fastest-validator": "^1.19.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ioredis": "^5.11.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
