{
  "nestedStrictDefaults": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "booking": {
        "type": "object",
        "properties": {
          "window": {
            "type": "object",
            "properties": {
              "limits": {
                "type": "object",
                "properties": {
                  "maxPerDay": {
                    "default": 8,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "allowOverlap": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "limits"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "window"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "booking"
    ],
    "additionalProperties": false
  },
  "recordEnumKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "propertyNames": {
      "type": "string",
      "enum": [
        "RUB",
        "USD",
        "EUR"
      ]
    },
    "additionalProperties": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "required": [
      "RUB",
      "USD",
      "EUR"
    ]
  },
  "enumDefault": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "default": "draft",
    "type": "string",
    "enum": [
      "draft",
      "active",
      "archived"
    ]
  },
  "intRange": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "integer",
    "minimum": 0,
    "maximum": 9007199254740991
  },
  "floatRange": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "number",
    "minimum": 0,
    "maximum": 100
  },
  "date": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
  },
  "datetimeMs": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
  },
  "uuid": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
  },
  "email": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
  },
  "pattern": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "minLength": 6,
    "maxLength": 6,
    "pattern": "^[0-9]{3}-[0-9]{2}$"
  },
  "optionalArray": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "withMeta": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "title": "Телефон",
    "widget": "phone"
  }
}
